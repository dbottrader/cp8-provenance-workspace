{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASINHH CP8 Meme Unit",
  "description": "A single heuristic rule or belief as stored in the lattice hypergraph.",
  "type": "object",
  "required": [
    "id",
    "type",
    "rule",
    "meta"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique meme identifier (UUID v4)."
    },
    "type": {
      "type": "string",
      "enum": [
        "core_axiom",
        "heuristic",
        "antibody",
        "meme_hypothesis",
        "ritual",
        "echo_node"
      ],
      "description": "Meme category in the CP8 taxonomy."
    },
    "rule": {
      "type": "object",
      "required": [
        "trigger",
        "action",
        "confidence"
      ],
      "properties": {
        "trigger": {
          "type": "string",
          "description": "Condition expressed in CP8 symbolic logic (e.g., 'WHEN market_volatility_spike > 3sigma')."
        },
        "action": {
          "type": "string",
          "description": "Response encoded as an ASINHH command or API call template."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Baseline confidence before sandbox testing."
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "source",
        "parent_ids",
        "created",
        "last_evaluated",
        "success_rate"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "simulation",
            "user",
            "agent_mutation",
            "counterfactual_replay",
            "echo_verification"
          ],
          "description": "Origin of this meme."
        },
        "parent_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Lineage of memes that were combined or mutated to create this one."
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "last_evaluated": {
          "type": "string",
          "format": "date-time"
        },
        "success_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Rolling success score from sandbox & real-world outcomes."
        }
      }
    },
    "lineage_signature": {
      "type": "string",
      "description": "Genetic hash of parent rules and mutation step, used for rollback & provenance."
    },
    "cp8_harmonic": {
      "type": "object",
      "description": "Optional resonance signature for echo-node tracking.",
      "properties": {
        "element": {
          "type": "string",
          "enum": [
            "air",
            "fire",
            "water",
            "earth"
          ]
        },
        "frequency_hz": {
          "type": "number"
        },
        "quadrant": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "mirror_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}